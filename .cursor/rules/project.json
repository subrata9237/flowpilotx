{
  "project": "flowpilotx",
  "rules": {
    "structure": {
      "sharedlib": {
        "allowedPackages": ["redis", "nats"],
        "requireReadme": true,
        "requireTests": true
      },
      "services": {
        "requireDockerfile": true,
        "requireConfig": true,
        "requireTests": true
      }
    },
    "versioning": {
      "goVersion": "1.24.2",
      "requireSemver": true,
      "requireChangelog": true
    },
    "dependencies": {
      "requireVersionPinning": true,
      "requireVendoring": false,
      "allowedLicenses": [
        "MIT",
        "Apache-2.0",
        "BSD-3-Clause"
      ]
    },
    "testing": {
      "coverage": {
        "minimum": 80,
        "excludePatterns": [
          "**/*_test.go",
          "**/mock_*.go",
          "**/testdata/*"
        ]
      },
      "integration": {
        "requireDockerCompose": true,
        "requireCleanup": true
      }
    },
    "documentation": {
      "requireReadme": true,
      "requireApiDocs": true,
      "requireChangelog": true
    }
  }
}
